# Connection string for Payload's Postgres adapter.
# Local dev: postgres://scheduler:scheduler@localhost:5433/course_scheduler (matches docker-compose defaults).
# Containerized app: hostname becomes "postgres" (the service name).
DATABASE_URL=postgres://scheduler:scheduler@localhost:5433/course_scheduler

# Used to sign Payload tokens (admin sessions). Generate with:
#   openssl rand -hex 32
PAYLOAD_SECRET=replace-me

# Docker-compose Postgres provisioning (only read by docker-compose).
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=scheduler
POSTGRES_DB=course_scheduler

# Public site URL, used in outgoing emails so links resolve to the real
# domain. Local dev can leave this unset.
# SITE_URL=https://scheduler.example.com

# Timezone for the app container and Postgres (docker-compose.prod.yml).
# Defaults to UTC; set this to wherever the schools/venues actually are.
# TZ=Europe/Amsterdam

# Transactional email via Resend (https://resend.com), added once the
# status-change notification phase lands. Not required for the MVP scaffold.
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=Course Scheduler <hello@your-domain.example>
